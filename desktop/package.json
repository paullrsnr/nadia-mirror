{
  "name": "nadia",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/paullrsnr/nadia-mirror.git"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && wait-on tcp:5173 && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "pack:win": "electron-builder --win --publish=never",
    "pack:mac": "electron-builder --mac --publish=never",
    "pack": "electron-builder --publish=never"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "@electron/notarize": "^3.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.plrconseil.nadia",
    "productName": "NadIA",
    "publish": null,
    "generateUpdatesFilesForAllChannels": false,
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/mac",
        "to": "backend"
      },
      {
        "from": "../backend/dist/win",
        "to": "backend"
      },
      {
        "from": "../backend/ressources",
        "to": "backend/ressources",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "gatekeeperAssess": false,
      "identity": "PLR CONSEIL"
    },
    "win": {
      "target": "nsis"
    }
  }
}
