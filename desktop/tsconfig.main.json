{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "rootDir": "src/main",
    "outDir": "dist/main",

    "moduleResolution": "node",
    "types": ["node", "electron"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/main/**/*"]
}
